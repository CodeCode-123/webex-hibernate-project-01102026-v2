<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuratio DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
<session-factory>
<!-- JDBC Connection -->
<property name="connection.driver_class">com.mysql.jdbc.Driver</property>
<property name="connection.url">jdbc:mysql://localhost:3306/db01102026v2</property>
<property name="connection.username">${DB_USERNAME}</property>
<property name="connection.password">${DB_PASSWORD}</property>
<!-- JDBC connection pool settings ... using built-in test pool -->
<property name="connection.pool_size">1</property>

<!-- Hibernate Configuration -->
    <property name="hibernate.hbm2ddl.auto">update</property>
    <!-- Select our SQL dialect -->
    <!-- we use MySQL5Dialect for the mysql version 5 -->
    <property name="dialect">org.hibernate.dialect.MySQL8Dialect</property>
    
    <!-- Echo the SQL to stdout -->
    <property name="show_sql">true</property>
    <!-- Set the current session context -->
    <property name="current_session_context_class">thread</property>
</session-factory>
</hibernate-configuration>